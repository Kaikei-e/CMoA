{
  "version": 2,
  "proposers": [
    {
      "id": "granite",
      "base_url": "http://127.0.0.1:8081/v1",
      "model": "granite-4.2-8b",
      "temperature": 0.2,
      "max_tokens": 512,
      "timeout_seconds": 600,
      "seed": 42
    },
    {
      "id": "qwen",
      "base_url": "http://127.0.0.1:8082/v1",
      "model": "qwen3.5-9b",
      "temperature": 0.2,
      "max_tokens": 512,
      "timeout_seconds": 600,
      "seed": 42
    },
    {
      "id": "gemma",
      "base_url": "http://127.0.0.1:8083/v1",
      "model": "gemma-4-12b",
      "temperature": 0.15,
      "max_tokens": 512,
      "timeout_seconds": 600,
      "seed": 42
    }
  ],
  "harness": {
    "vault": "/srv/example/vault",
    "docdag": "/srv/example/bin/docdag"
  },
  "verify": {
    "max_parallel": 1,
    "timeout_seconds": 600
  },
  "selection": {
    "rule": "first"
  },
  "judge": {
    "base_url": "http://127.0.0.1:8090/v1",
    "model": "gpt-oss-20b",
    "temperature": 0,
    "max_tokens": 512,
    "timeout_seconds": 180,
    "seed": 7,
    "parallel": 6,
    "output_format": "json_schema",
    "extra_body": {
      "chat_template_kwargs": {
        "reasoning_effort": "low"
      }
    }
  },
  "serve": {
    "listen": "127.0.0.1:8095",
    "pool_name": "cmoa",
    "runs_dir": "serve-runs",
    "max_body_bytes": 1048576,
    "max_inflight": 1
  }
}
